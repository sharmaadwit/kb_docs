.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints/
artifacts/
*.pptx
.antigravityignore
kb/.DS_Store

# Agent-generated (do not commit; Cursor / local agent may create these)
SKILL.md
**/SKILL.md
# ...except the deployed skill manifest, mirrored here for parity
!skill/SKILL.md

# Secrets + local Langfuse credentials (never commit)
.cursor/
.env
.env.*
.env.example

# Repo scope policy (2026-08-22): git tracks ONLY what's required to run the
# skill in SuperAgent (skill/, kb/ incl. kb_chunks.jsonl/kb_index.json/
# manifests) plus local/reports/comprehensive_dashboard.html. Everything else
# — dev tooling, tests, docs, analysis reports, IDE state, logs — stays local
# and untracked, in place, for day-to-day use. Rarely-needed historical
# material lives physically under archive/ (also untracked).
archive/
.idea/
.logs/
local/*
!local/reports/
local/reports/*
!local/reports/comprehensive_dashboard.html
!local/scripts/
!local/supervisor/
local/supervisor/logs/
local/supervisor/judge_outputs/
local/supervisor/context/
local/supervisor/__pycache__/
local/supervisor/utils/__pycache__/
local/supervisor/tests/__pycache__/

# Usage telemetry (auto-committed externally to kb/analytics/ historically;
# local-only per this policy going forward)
kb/analytics/

# Internal implementation/consulting docs (local use only)
CONSULTING_MODE_*.md

# YouTube auth + transcript build intermediates (never commit; secrets/raw)
cookies.txt
**/cookies.txt
